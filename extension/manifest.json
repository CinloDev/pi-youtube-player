{
  "manifest_version": 3,
  "name": "Pi YouTube Bridge",
  "version": "1.1.0",
  "description": "Puente local y seguro entre YouTube / YouTube Music y el agente Pi",
  "permissions": [
    "tabs",
    "scripting",
    "debugger"
  ],
  "host_permissions": [
    "https://music.youtube.com/*",
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.youtube.com/*",
        "https://www.youtube.com/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://music.youtube.com/*",
        "https://www.youtube.com/*"
      ],
      "js": [
        "main-world.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
